<launch>
    <!-- 集中定义参数 -->
    <arg name="drone_id" default="1" />
    <arg name="robot_id" default="$(arg drone_id)" />
    <arg name="init_x" default="0.0" />
    <arg name="init_y" default="0.0" />
    <arg name="init_z" default="1.0" />
    <!--  disabled/manual -->
    <arg name="phase_offset_mode" default="manual" />
    <arg name="phase_offset_coordination_backend" default="disabled" />
    <arg name="enable_neighbor_transport" default="false" />
    <arg name="enable_sph_provider" default="false" />
    <arg name="phase_offset_sph_beta_topic"
         default="/uav_$(arg drone_id)/phase_offset/sph_beta" />
    <arg name="phase_offset_sph_g_coord_topic"
         default="/uav_$(arg drone_id)/phase_offset/g_coord" />
    <arg name="phase_offset_g_coord_fresh_timeout" default="0.10" />
    <arg name="phase_offset_future_timestamp_tolerance" default="0.02" />
    <arg name="phase_offset_shadow_delta" default="0.0" />
    <arg name="phase_offset_shadow_sample_step_w" default="0.10" />
    <arg name="phase_offset_shadow_publish_rate" default="5.0" />
    <arg name="phase_offset_frame_id" default="world" />
    <arg name="phase_offset_active_equivalence_tolerance" default="1e-10" />
    <arg name="phase_offset_active_required_consecutive_cycles" default="100" />
    <arg name="phase_offset_manual_amplitude" default="0.10" />
    <!-- false正式接入导航 -->
    <arg name="phase_offset_manual_observe_only" default="false" />
    <!-- 10.0/2.0 -->
    <arg name="phase_offset_manual_profile_period" default="10.0" />
    <arg name="phase_offset_manual_warmup_cycles" default="100" />
    <arg name="phase_offset_manual_delta_tracking_gain" default="3.0" />
    <arg name="phase_offset_manual_u_w_amplitude" default="0.05" />
    <arg name="phase_offset_manual_u_w_abs_max" default="0.12" />
    <arg name="phase_offset_manual_u_delta_abs_max" default="0.25" />
    <arg name="phase_offset_manual_u_w_rate_max" default="0.60" />
    <arg name="phase_offset_manual_u_delta_rate_max" default="1.20" />
    <arg name="phase_offset_manual_phase_dot_min" default="0.02" />
    <arg name="phase_offset_manual_tangent_speed_min" default="0.02" />
    <arg name="phase_offset_manual_preflight_sample_step_w" default="0.10" />
    <!--  none/esdf/fixed -->
    <arg name="phase_offset_manual_tube_source" default="esdf" />
    <!-- NORMAL Preview policy is intentionally unset by default.  The
         integration stages pass all six values explicitly; empty values do
         not create production parameters on the server. -->
    <arg name="phase_offset_normal_preview_horizon_w" default="1.0" />
    <arg name="phase_offset_normal_preview_sample_spacing_w" default="0.25" />
    <arg name="phase_offset_normal_preview_lower_nu" default="0.02" />
    <arg name="phase_offset_normal_preview_upper_nu" default="2.0" />
    <arg name="phase_offset_normal_preview_b_tight" default="0.10" />
    <arg name="phase_offset_normal_preview_b_open" default="0.90" />
    <arg name="phase_offset_tube_nominal_half_width" default="1.0" />
    <arg name="phase_offset_tube_sample_step_w" default="0.10" />
    <arg name="phase_offset_tube_lookahead_w" default="2.0" />
    <arg name="phase_offset_tube_back_w" default="0.20" />
    <arg name="phase_offset_tube_min_certified_forward_w" default="0.40" />
    <arg name="phase_offset_tube_invariant_gain" default="1.0" />
    <arg name="phase_offset_tube_interior_margin" default="0.0" />
    <arg name="phase_offset_tube_update_period" default="0.10" />
    <!-- Transverse half width the Section tube may claim on each side of the
         path, measured after the configured clearance is taken off the free
         distance.  The map view is requested one clearance wider so this value
         is reachable in open space. -->
    <arg name="phase_offset_tube_environment_search_extent" default="1.5" />
    <!-- Corridor-only clearance between the tube wall and the first occupied
         voxel.  Independent of planning/safe_distance, which keeps governing
         the B-spline obstacle preference. -->
    <arg name="phase_offset_tube_section_clearance" default="0.20" />
    <arg name="phase_offset_tube_raw_regularity_margin" default="0.10" />
    <arg name="phase_offset_tube_min_regularity_ratio" default="0.35" />
    <arg name="phase_offset_tube_raw_tracking_error_bound" default="0.15" />
    <!-- Explicit opt-in: local_sensing publishes the complete local obstacle
         set in its update AABB.  This launch starts that producer itself, so
         the Section tube can declare a known domain and be built.  A workspace
         whose cloud topic carries raw sparse hit points must set this false
         again, because then the unknown region is genuinely unknown. -->
    <arg name="phase_offset_tube_cloud_obstacle_set_complete" default="true" />
    <!-- Section build work budgets.  These are honest truncation limits for
         the profile prefix, not safety gates: the local view exposes one box
         per occupied native voxel, so the per-cell obstacle loop needs a
         budget sized for the configured sensing volume. -->
    <arg name="phase_offset_tube_section_max_obstacle_checks" default="4000000" />
    <arg name="phase_offset_tube_section_max_obstacles" default="60000" />
    <arg name="phase_offset_tube_section_max_cells" default="20000" />
    <arg name="phase_offset_measurement_enable" default="false" />
    <arg name="phase_offset_measurement_callback_csv_path" default="" />
    <arg name="phase_offset_measurement_tube_due_csv_path" default="" />
    <arg name="sdf_map_buffer_refresh_period" default="3.0" />
    <!-- Planning  parameters-->
    <arg name="map_size_x_" value="20.0"/>
    <arg name="map_size_y_" value="30.0"/>
    <arg name="map_size_z_" value=" 2.5"/>

    <arg name="local_update_range_x" value="4.0"/>
    <arg name="local_update_range_y" value="4.0"/>
    <arg name="local_update_range_z" value="2.5"/>
    
    <arg name="v_max" value="2.0"/>
    <arg name="a_max" value="2.5"/>
    <!-- <arg name="v_max" value="0.8"/>
    <arg name="a_max" value="1.2"/>    -->
    
  <!-- node_output: "screen" for the single-UAV chain; the swarm passes "log" so
       each agent's planner writes its own file under ~/.ros/log/<run>/, which is
       what a per-agent stall investigation needs. -->
  <arg name="node_output" default="screen"/>
  <node name="formation_planning" pkg="bspline_race" type="formation_planning" output="$(arg node_output)">
        <!-- Plan Manager -->
        <param name="gvf/cloud_topic"      type="string" value="/sim/local_map" />
        <param name="gvf/odom_topic"       type="string" value="/sim/odom" />
        <param name="gvf/cmd_topic"        type="string" value="/position_cmd" />
        <param name="phase_offset/mode" value="$(arg phase_offset_mode)" />
        <param name="robot_id" value="$(arg robot_id)" />
        <param name="phase_offset/coordination_backend"
               value="$(arg phase_offset_coordination_backend)" />
        <param name="enable_neighbor_transport"
               value="$(arg enable_neighbor_transport)" />
        <param name="enable_sph_provider"
               value="$(arg enable_sph_provider)" />
        <param name="phase_offset/sph_beta_topic"
               value="$(arg phase_offset_sph_beta_topic)" />
        <param name="phase_offset/sph_g_coord_topic"
               value="$(arg phase_offset_sph_g_coord_topic)" />
        <param name="phase_offset/g_coord_fresh_timeout"
               value="$(arg phase_offset_g_coord_fresh_timeout)" />
        <param name="phase_offset/future_timestamp_tolerance"
               value="$(arg phase_offset_future_timestamp_tolerance)" />
        <param name="phase_offset/shadow_delta" value="$(arg phase_offset_shadow_delta)" />
        <param name="phase_offset/shadow_sample_step_w" value="$(arg phase_offset_shadow_sample_step_w)" />
        <param name="phase_offset/shadow_publish_rate" value="$(arg phase_offset_shadow_publish_rate)" />
        <param name="phase_offset/frame_id" value="$(arg phase_offset_frame_id)" />
        <param name="phase_offset/active_equivalence_tolerance" value="$(arg phase_offset_active_equivalence_tolerance)" />
        <param name="phase_offset/active_required_consecutive_cycles" value="$(arg phase_offset_active_required_consecutive_cycles)" />
        <param name="phase_offset/manual/amplitude" value="$(arg phase_offset_manual_amplitude)" />
        <param name="phase_offset/manual/observe_only" value="$(arg phase_offset_manual_observe_only)" />
        <param name="phase_offset/manual/profile_period" value="$(arg phase_offset_manual_profile_period)" />
        <param name="phase_offset/manual/warmup_cycles" value="$(arg phase_offset_manual_warmup_cycles)" />
        <param name="phase_offset/manual/delta_tracking_gain" value="$(arg phase_offset_manual_delta_tracking_gain)" />
        <param name="phase_offset/manual/u_w_amplitude" value="$(arg phase_offset_manual_u_w_amplitude)" />
        <param name="phase_offset/manual/u_w_abs_max" value="$(arg phase_offset_manual_u_w_abs_max)" />
        <param name="phase_offset/manual/u_delta_abs_max" value="$(arg phase_offset_manual_u_delta_abs_max)" />
        <param name="phase_offset/manual/u_w_rate_max" value="$(arg phase_offset_manual_u_w_rate_max)" />
        <param name="phase_offset/manual/u_delta_rate_max" value="$(arg phase_offset_manual_u_delta_rate_max)" />
        <param name="phase_offset/manual/phase_dot_min" value="$(arg phase_offset_manual_phase_dot_min)" />
        <param name="phase_offset/manual/tangent_speed_min" value="$(arg phase_offset_manual_tangent_speed_min)" />
        <param name="phase_offset/manual/preflight_sample_step_w" value="$(arg phase_offset_manual_preflight_sample_step_w)" />
        <param name="phase_offset/manual/tube_source" value="$(arg phase_offset_manual_tube_source)" />
        <param if="$(eval arg('phase_offset_normal_preview_horizon_w') != '')"
               name="phase_offset/normal_preview/preview_horizon_w"
               value="$(arg phase_offset_normal_preview_horizon_w)" />
        <param if="$(eval arg('phase_offset_normal_preview_sample_spacing_w') != '')"
               name="phase_offset/normal_preview/sample_spacing_w"
               value="$(arg phase_offset_normal_preview_sample_spacing_w)" />
        <param if="$(eval arg('phase_offset_normal_preview_lower_nu') != '')"
               name="phase_offset/normal_preview/lower_nu"
               value="$(arg phase_offset_normal_preview_lower_nu)" />
        <param if="$(eval arg('phase_offset_normal_preview_upper_nu') != '')"
               name="phase_offset/normal_preview/upper_nu"
               value="$(arg phase_offset_normal_preview_upper_nu)" />
        <param if="$(eval arg('phase_offset_normal_preview_b_tight') != '')"
               name="phase_offset/normal_preview/b_tight"
               value="$(arg phase_offset_normal_preview_b_tight)" />
        <param if="$(eval arg('phase_offset_normal_preview_b_open') != '')"
               name="phase_offset/normal_preview/b_open"
               value="$(arg phase_offset_normal_preview_b_open)" />
        <param name="phase_offset/tube/nominal_half_width" value="$(arg phase_offset_tube_nominal_half_width)" />
        <param name="phase_offset/tube/sample_step_w" value="$(arg phase_offset_tube_sample_step_w)" />
        <param name="phase_offset/tube/lookahead_w" value="$(arg phase_offset_tube_lookahead_w)" />
        <param name="phase_offset/tube/back_w" value="$(arg phase_offset_tube_back_w)" />
        <param name="phase_offset/tube/min_certified_forward_w" value="$(arg phase_offset_tube_min_certified_forward_w)" />
        <param name="phase_offset/tube/invariant_gain" value="$(arg phase_offset_tube_invariant_gain)" />
        <param name="phase_offset/tube/interior_margin" value="$(arg phase_offset_tube_interior_margin)" />
        <param name="phase_offset/tube/update_period" value="$(arg phase_offset_tube_update_period)" />
        <param name="phase_offset/tube/environment_search_extent" value="$(arg phase_offset_tube_environment_search_extent)" />
        <param name="phase_offset/tube/section_clearance" value="$(arg phase_offset_tube_section_clearance)" />
        <param name="phase_offset/tube/raw_regularity_margin" value="$(arg phase_offset_tube_raw_regularity_margin)" />
        <param name="phase_offset/tube/min_regularity_ratio" value="$(arg phase_offset_tube_min_regularity_ratio)" />
        <param name="phase_offset/tube/raw_tracking_error_bound" value="$(arg phase_offset_tube_raw_tracking_error_bound)" />
        <param name="phase_offset/tube/cloud_obstacle_set_complete" value="$(arg phase_offset_tube_cloud_obstacle_set_complete)" />
        <param name="phase_offset/tube/section_max_obstacle_checks" value="$(arg phase_offset_tube_section_max_obstacle_checks)" />
        <param name="phase_offset/tube/section_max_obstacles" value="$(arg phase_offset_tube_section_max_obstacles)" />
        <param name="phase_offset/tube/section_max_cells" value="$(arg phase_offset_tube_section_max_cells)" />
        <param name="phase_offset/measurement/enable" value="$(arg phase_offset_measurement_enable)" />
        <param name="phase_offset/measurement/callback_csv_path" value="$(arg phase_offset_measurement_callback_csv_path)" />
        <param name="phase_offset/measurement/tube_due_csv_path" value="$(arg phase_offset_measurement_tube_due_csv_path)" />
        <param name="gvf/planInterval"     value="0.5" /> 
        <param name="gvf/num_points_to_take" value="30" />
        <param name="gvf/use_test_cmd" value="false" />
        <!-- 正方形 GVF 网格独立以 20 Hz 刷新；地图/ESDF 保持 10 Hz -->
        <param name="gvf/vector_field_vis_interval" value="0.05" />
        <!-- 闭合轨迹新实现；circle_test 未启用时不影响点到点导航 -->
        <param name="gvf/closed_tracking_mode" value="closed_phase_v2" />
        <param name="gvf/closed_phase_v2/enable_c2_connector" value="true" />
        <param name="gvf/closed_phase_v2/c2_join_min_w" value="0.5" />
        <param name="gvf/closed_phase_v2/c2_join_max_w" value="1.0" />
        <param name="gvf/closed_phase_v2/c2_join_step_w" value="0.25" />
        <param name="gvf/closed_phase_v2/c2_sample_step_w" value="0.05" />
        <param name="gvf/closed_phase_v2/back_margin_w" value="1.0" />
        <!-- 点到点使用有限统一相位；circle_test 启用时自动由闭合模式接管 -->
        <param name="gvf/point_phase_v2/enable" value="true" />
        <param name="gvf/point_phase_v2/enable_c2_connector" value="true" />
        <param name="gvf/point_phase_v2/endpoint_margin_w" value="0.05" />
        <!-- <param name="gvf/circle_test/enable" value="false" />
        <param name="gvf/circle_test/auto_start" value="false" />
        <param name="gvf/circle_test/shape" value="figure8" />
        <param name="gvf/circle_test/radius" value="8.0" />
        <param name="gvf/circle_test/figure8_radius" value="10.0" />
        <param name="gvf/circle_test/height" value="1.0" />
        <param name="gvf/circle_test/points" value="480" />
        <param name="gvf/circle_test/lookahead_pts" value="40" />
        <param name="gvf/circle_test/lookahead_min_w" value="1.0" />
        <param name="gvf/circle_test/lookahead_max_w" value="3.0" />
        <param name="gvf/circle_test/lookahead_step_w" value="0.5" />
        <param name="gvf/circle_test/realign_min_progress" value="3.0" />
        <param name="gvf/circle_test/join_search_window" value="30" />
        <param name="gvf/circle_test/join_lookahead_pts" value="8" />
        <param name="gvf/circle_test/join_exit_dist" value="0.8" />
        <param name="gvf/circle_test/join_exit_stable_needed" value="5" />
        <param name="gvf/circle_test/center_x" value="0.0" />
        <param name="gvf/circle_test/center_y" value="0.0" />
        <param name="gvf/circle_test/center_z" value="0.0" /> -->

        <param name="gvf/circle_test/enable" value="false" />
        <param name="gvf/circle_test/auto_start" value="false" />
        <!-- circle/figure8 -->
        <param name="gvf/circle_test/shape" value="circle" />
        <param name="gvf/circle_test/radius" value="8.0" />
        <param name="gvf/circle_test/figure8_radius" value="10.0" />
        <param name="gvf/circle_test/height" value="1.0" />
        <param name="gvf/circle_test/points" value="960" />
        <param name="gvf/circle_test/acquire_distance" value="0.5" />
        <param name="gvf/circle_test/lookahead_min_w" value="3.0" />
        <param name="gvf/circle_test/lookahead_max_w" value="6.0" />
        <param name="gvf/circle_test/goal_prefer_lookahead_w" value="3.0" />
        <param name="gvf/circle_test/goal_push_past_obstacle" value="true" />
        <param name="gvf/circle_test/goal_obstacle_check_step_w" value="0.1" />
        <param name="gvf/circle_test/goal_obstacle_pass_margin_w" value="0.8" />
        <param name="gvf/circle_test/center_x" value="0.0" />
        <param name="gvf/circle_test/center_y" value="0.0" />


        <!-- KinoA*: guide points 采样 -->
        <param name="gvf/kino_sample_ts" value="0.15" />
        <param name="gvf/kino_sample_ts_min" value="0.05" />
        <param name="gvf/kino_max_guide_pts" value="60" />

        <!-- 该参数决定前向跟踪速度 -->
        <param name="gvf/gvf_gain1"       value="2.0"/>
        <!-- <param name="gvf/gvf_gain1"       value="0.8"/> -->
        <!-- 该参数决定后退/回拉速度 -->
        <param name="gvf/gvf_gain2"       value="-2.2"/>
        <!-- <param name="gvf/gvf_gain2"       value="-1.2"/> -->
        <param name="gvf/gvf_k3"          value="1.0"/>
        <param name="gvf/gvf_k4"          value="1.0"/>
        <param name="gvf/gvf_inflation"  value="0.099" /> 
        <param name="gvf/gvf_use_kinopath" value="false" />
        <param name="gvf/gvf_use_quad_fit" value="true"/>
        <!-- GVF局部更新范围参数 -->
        <param name="gvf/local_update_range_x" value="3.0" />
        <param name="gvf/local_update_range_y" value="3.0" />
        <param name="gvf/local_update_range_z" value="2.05" />
        <!-- 碰撞检测参数 -->
        <param name="gvf/collision_threshold" value="0.15" />
        <!-- 自适应GVF参数配置 -->
        <param name="gvf/adaptive_enabled" value="false" />
        <param name="gvf/convergence_bandwidth" value="0.10" />
        <param name="gvf/k1_min_scale" value="0.1" />
        <param name="gvf/k1_max_scale" value="3.0" />
        <param name="gvf/k2_min_scale" value="0.5" />
        <param name="gvf/k2_max_scale" value="2.0" />
        <param name="gvf/debug_output" value="true" />


       <param name="gvf/debug_gate" value="true"/>

        <!-- vel_max/speed_max: GVF 与 cmd_pos 的速度上限 -->
        <param name="gvf/cmd/vel_max" value="2.0" />

        <!-- acc_max: governor 输出诊断用加速度阈值 -->
        <param name="gvf/cmd/acc_max" value="8.0" />

        <param name="gvf/cmd/pos_gain_equiv" value="1.65" />
        <param name="gvf/cmd/switch_motion_limit_time" value="0.25" />
        <param name="gvf/cmd/tangent_vel_max" value="2.0" />
        <param name="gvf/cmd/governor_l_min" value="0.0" />
        <param name="gvf/cmd/governor_l_max" value="1.6" />
        <param name="gvf/cmd/governor_l_step" value="0.05" />
        <param name="gvf/cmd/governor_l_rate_max" value="4.0" />
        <param name="gvf/cmd/governor_l_ff_weight" value="0.8" />
        <param name="gvf/cmd/governor_lead_max" value="1.6" />
        <!-- Persistent no-valid-candidate unlock: after this many seconds with
             an empty candidate set (and real path still ahead) the phase is
             re-anchored to the vehicle instead of holding forever.  <= 0
             disables it. -->
        <param name="gvf/cmd/governor_unlock_timeout" value="1.0" />
        <param name="gvf/cmd/governor_normal_cross_max" value="0.08" />
        <param name="gvf/cmd/governor_normal_deadband" value="0.05" />
        <param name="gvf/cmd/governor_normal_full_error" value="0.20" />
        <param name="gvf/cmd/governor_normal_max" value="0.25" />
        <param name="gvf/cmd/governor_normal_rate_max" value="0.5" />
        <param name="gvf/cmd/governor_l_rate_weight" value="0.005" />
        <param name="gvf/cmd/governor_normal_weight" value="0.60" />
        <param name="gvf/cmd/governor_normal_rate_weight" value="0.10" />
        <param name="gvf/cmd/governor_tau_vel_weight" value="1.0" />
        <param name="gvf/cmd/governor_normal_vel_weight" value="1.0" />
        <param name="gvf/cmd/governor_normal_vel_error_cap" value="2.0" />


        <!-- Gain test: 固定位置领先距离测量位置环等效增益，测完改回 false -->
        <param name="gvf/cmd/gain_test_enable" value="false" />
        <param name="gvf/cmd/gain_test_lead" value="1.21" />
        <param name="gvf/cmd/gain_test_axis" value="0" />
        <param name="gvf/odom_vel_est_window" value="0.3" />
        <param name="gvf/odom_vel_lpf_hz" value="2.0" />
        

        <!-- SDF Map -->
        <param name="sdf_map/resolution"   value="0.1" /> 
        <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
        <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
        <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 

        <param name="sdf_map/local_update_range_x"  value="$(arg local_update_range_x)" /> 
        <param name="sdf_map/local_update_range_y"  value="$(arg local_update_range_y)" /> 
        <param name="sdf_map/local_update_range_z"  value="$(arg local_update_range_z)" /> 
        
        <param name="sdf_map/obstacles_inflation"     value="0.099" /> 
        <param name="sdf_map/local_bound_inflate"    value="0.0"/>
        <param name="sdf_map/local_map_margin" value="50"/>
        <param name="sdf_map/ground_height"        value="-0.01"/>
        <param name="sdf_map/enable_manual_map" value="true" />
        <param name="sdf_map/manual_click_direct" value="true" />
        <param name="sdf_map/manual_obstacle_radius" value="0.35" />
        <param name="sdf_map/manual_obstacle_height" value="2.5" />
        <param name="sdf_map/manual_obstacle_inflate" value="0.10" />
        <param name="sdf_map/manual_boundary_padding" value="0.10" />
        <param name="sdf_map/manual_boundary_z_min" value="0.0" />
        <param name="sdf_map/manual_boundary_z_max" value="2.5" />
        <param name="sdf_map/manual_map_file" value="$(find bspline_race)/config/manual_obstacles_test_gvf.txt" />
        <param name="sdf_map/manual_map_auto_load" value="true" />
        <param name="sdf_map/manual_map_auto_save" value="true" />

        <!-- depth filter -->
        <param name="sdf_map/use_depth_filter" value="true"/>
        <param name="sdf_map/depth_filter_tolerance" value="0.15"/>
        <param name="sdf_map/depth_filter_maxdist"   value="5.0"/>
        <param name="sdf_map/depth_filter_mindist"   value="0.2"/>
        <param name="sdf_map/depth_filter_margin"    value="2"/>
        <param name="sdf_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="sdf_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="sdf_map/p_hit"  value="0.65"/>
        <param name="sdf_map/p_miss" value="0.35"/>
        <param name="sdf_map/p_min"  value="0.12"/>
        <param name="sdf_map/p_max"  value="0.90"/>
        <param name="sdf_map/p_occ"  value="0.80"/>
        <param name="sdf_map/min_ray_length" value="0.5"/>
        <param name="sdf_map/max_ray_length" value="4.5"/>
        <param name="sdf_map/esdf_slice_height" value="0.3"/>
        <param name="sdf_map/visualization_truncate_height"   value="2.49"/>
        <param name="sdf_map/virtual_ceil_height"   value="2.5"/>
        <param name="sdf_map/show_occ_time"  value="false"/>
        <param name="sdf_map/show_esdf_time" value="false"/>
        <param name="sdf_map/pose_type"     value="2"/>  
        <param name="sdf_map/frame_id"      value="world"/>
        <param name="sdf_map/buffer_refresh_period"
               value="$(arg sdf_map_buffer_refresh_period)" />
        <!-- geometric path searching -->
        <param name="astar/lambda_heu" value="10.0" type="double"/>
        <param name="astar/resolution_astar" value="0.1" type="double"/>
        <param name="astar/time_resolution" value="0.8" type="double"/>
        <param name="astar/margin" value="0.6" type="double"/>
        <param name="astar/z_min" value="0.8" type="double"/>
        <param name="astar/z_max" value="1.2" type="double"/>
        <param name="astar/z_ref" value="1.0" type="double"/>
        <param name="astar/w_z" value="20.0" type="double"/>
        <param name="astar/allocate_num" value="1000000" type="int"/>
        <param name="astar/path_sample_interval" value="2" type="int"/>

          <!-- kinodynamic path searching -->
        <param name="search/max_tau" value="0.6" type="double"/>
        <param name="search/init_max_tau" value="0.6" type="double"/>
        <param name="search/max_vel" value="2.0" type="double"/>
        <param name="search/max_acc" value="2.5" type="double"/>
        <param name="search/w_time" value="10.0" type="double"/>
        <param name="search/horizon" value="5.0" type="double"/>
        <param name="search/lambda_heu" value="5.0" type="double"/>
        <param name="search/resolution_astar" value="0.05" type="double"/>
        <param name="search/time_resolution" value="0.33" type="double"/>
        <param name="search/margin" value="0.5" type="double"/>
        <param name="search/allocate_num" value="100000" type="int"/>
        <param name="search/check_num" value="5" type="int"/>
        <!-- Kino A* altitude search band.  Map z extent is left untouched
             (sdf_map/map_size_z stays 2.5), so the search may use 0.5-2.0 m
             inside that map. -->
        <param name="search/z_min" value="0.5" type="double"/>
        <param name="search/z_max" value="2.0" type="double"/>

        <!-- kinodynamic path searching -->
        <!-- <param name="search/max_tau" value="0.6" type="double"/>
        <param name="search/init_max_tau" value="0.8" type="double"/>
        <param name="search/max_vel" value="2.5" type="double"/>
        <param name="search/max_acc" value="3.0" type="double"/>
        <param name="search/w_time" value="10.0" type="double"/>
        <param name="search/horizon" value="6.0" type="double"/>
        <param name="search/lambda_heu" value="10.0" type="double"/>
        <param name="search/resolution_astar" value="0.1" type="double"/>
        <param name="search/time_resolution" value="0.8" type="double"/>
        <param name="search/margin" value="0.6" type="double"/>
        <param name="search/allocate_num" value="100000" type="int"/>
        <param name="search/check_num" value="5" type="int"/> -->


        <!-- bspline opt -->
        <param name="planning/traj_order" value="3"/>
        <param name="planning/dimension" value="3" />
        <param name="planning/TrajSampleRate" value="50" />
        <param name="planning/max_vel" value="$(arg v_max)" />
        <param name="planning/max_acc" value="$(arg a_max)" />
        <param name="planning/lambda1" value="8.0" />
        <param name="planning/lambda2" value="5.0" />
        <param name="planning/lambda3" value="10.0" />
        <param name="planning/dist_p" value="0.5" />
        <param name="planning/safe_distance" value="0.4" />
        <param name="planning/opt_maxeval" value="200" />
        <param name="planning/opt_maxtime" value="0.02" />
    </node>

    <node pkg="map_generator" type="local_sensing" name="map_generator" output="screen">
        <param name="sdf_map/resolution" value="0.1" />
        <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
        <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
        <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 
        <param name="sdf_map/local_update_range_x"  value="$(arg local_update_range_x)" /> 
        <param name="sdf_map/local_update_range_y"  value="$(arg local_update_range_y)" /> 
        <param name="sdf_map/local_update_range_z"  value="$(arg local_update_range_z)" /> 
    </node>
</launch>
