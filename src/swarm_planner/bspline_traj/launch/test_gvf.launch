<launch>
    <!-- 集中定义参数 -->
    <arg name="drone_id" default="1" />
    <arg name="init_x" default="0.0" />
    <arg name="init_y" default="0.0" />
    <arg name="init_z" default="1.0" />
    <!-- Planning  parameters-->
    <arg name="map_size_x_" value="20.0"/>
    <arg name="map_size_y_" value="30.0"/>
    <arg name="map_size_z_" value=" 2.5"/>

    <arg name="local_update_range_x" value="6.0"/>
    <arg name="local_update_range_y" value="6.0"/>
    <arg name="local_update_range_z" value="2.5"/>
    
    <arg name="v_max" value="2.0"/>     
    <arg name="a_max" value="2.5"/>     
    
  <node name="formation_planning" pkg="bspline_race" type="formation_planning" output="screen">
        <!-- Plan Manager -->
        <param name="gvf/cloud_topic"      type="string" value="/sim/local_map" />
        <param name="gvf/odom_topic"       type="string" value="/sim/odom" />
        <param name="gvf/cmd_topic"        type="string" value="/position_cmd" />
        <param name="gvf/planInterval"     value="0.5" /> 
        <param name="gvf/num_points_to_take" value="30" />
        <param name="gvf/use_test_cmd" value="false" />
        <!-- <param name="gvf/circle_test/enable" value="false" />
        <param name="gvf/circle_test/auto_start" value="false" />
        <param name="gvf/circle_test/shape" value="figure8" />
        <param name="gvf/circle_test/radius" value="8.0" />
        <param name="gvf/circle_test/figure8_radius" value="10.0" />
        <param name="gvf/circle_test/height" value="1.0" />
        <param name="gvf/circle_test/points" value="480" />
        <param name="gvf/circle_test/lookahead_pts" value="40" />
        <param name="gvf/circle_test/realign_min_progress" value="3.0" />
        <param name="gvf/circle_test/join_search_window" value="30" />
        <param name="gvf/circle_test/join_lookahead_pts" value="8" />
        <param name="gvf/circle_test/join_exit_dist" value="0.8" />
        <param name="gvf/circle_test/join_exit_stable_needed" value="5" />
        <param name="gvf/circle_test/center_x" value="0.0" />
        <param name="gvf/circle_test/center_y" value="0.0" />
        <param name="gvf/circle_test/center_z" value="0.0" /> -->

        <param name="gvf/circle_test/enable" value="false" />
        <param name="gvf/circle_test/auto_start" value="false" />
        <!-- circle/figure8 -->
        <param name="gvf/circle_test/shape" value="circle" />
        <param name="gvf/circle_test/radius" value="8.0" />
        <param name="gvf/circle_test/figure8_radius" value="10.0" />
        <param name="gvf/circle_test/height" value="1.0" />
        <param name="gvf/circle_test/points" value="480" />
        <param name="gvf/circle_test/lookahead_pts" value="40" />
        <param name="gvf/circle_test/realign_min_progress" value="3.0" />
        <param name="gvf/circle_test/join_search_window" value="30" />
        <param name="gvf/circle_test/join_lookahead_pts" value="8" />
        <param name="gvf/circle_test/join_exit_dist" value="0.8" />
        <param name="gvf/circle_test/join_exit_stable_needed" value="5" />
        <param name="gvf/circle_test/center_x" value="0.0" />
        <param name="gvf/circle_test/center_y" value="0.0" />
        <param name="gvf/circle_test/center_z" value="0.0" />


        <!-- KinoA*: guide points 采样 -->
        <param name="gvf/kino_sample_ts" value="0.15" />
        <param name="gvf/kino_sample_ts_min" value="0.05" />
        <param name="gvf/kino_max_guide_pts" value="60" />

        <!-- 发布给 GVF / RViz 的路径长度（只发布当前位置之后一段，避免“永远很长”） -->
        <param name="gvf/path_pub_from_current" value="true" />
        <param name="gvf/path_pub_future_pts" value="200" />

        <!-- 到达目标附近并且速度很小就停止重规划（避免 start≈goal 时反复出圈/长轨迹） -->
        <param name="gvf/replan_stop_radius" value="0.35" />
        <param name="gvf/replan_stop_vel" value="0.20" />
        <!-- 该参数决定前向跟踪速度 -->
        <!-- <param name="gvf/gvf_gain1"       value="2.5"/> -->
        <param name="gvf/gvf_gain1"       value="2.0"/>
        <!-- 该参数决定后退/回拉速度 -->
        <!-- <param name="gvf/gvf_gain2"       value="-2.0"/> -->
        <param name="gvf/gvf_gain2"       value="-1.2"/>
        <param name="gvf/gvf_k3"          value="1.0"/>
        <param name="gvf/gvf_k4"          value="1.0"/>
        <param name="gvf/gvf_inflation"  value="0.099" /> 
        <param name="gvf/gvf_use_kinopath" value="false" />
        <param name="gvf/gvf_use_quad_fit" value="true"/>
        <!-- GVF局部更新范围参数 -->
        <param name="gvf/local_update_range_x" value="3.0" />
        <param name="gvf/local_update_range_y" value="3.0" />
        <param name="gvf/local_update_range_z" value="2.05" />
        <!-- 碰撞检测参数 -->
        <param name="gvf/collision_threshold" value="0.15" />
        <!-- 自适应GVF参数配置 -->
        <param name="gvf/adaptive_enabled" value="false" />
        <param name="gvf/convergence_bandwidth" value="0.10" />
        <param name="gvf/k1_min_scale" value="0.1" />
        <param name="gvf/k1_max_scale" value="3.0" />
        <param name="gvf/k2_min_scale" value="0.5" />
        <param name="gvf/k2_max_scale" value="2.0" />
        <param name="gvf/debug_output" value="true" />


       <param name="gvf/debug_gate" value="true"/>

        <!-- vel_max: GVF 速度限幅（越大越快，但也更容易超调/抖动） -->
        <param name="gvf/cmd/vel_max" value="2.0" />
        <!-- k_pull: 回拉增益，越大 ref_pos 越贴着飞机（更稳但更慢） -->
        <param name="gvf/cmd/k_pull" value="2.0" />
        <!-- lookahead_time: 前视时间 T，cmd_pos = pos + T*vel（越大越快，但更“猛”） -->
        <param name="gvf/cmd/lookahead_time" value="0.3" />
        <!-- lookahead_dist: 前视点最大水平距离 Lmax（越大越快，但更“猛”） -->
        <param name="gvf/cmd/lookahead_dist" value="0.6" />
        <!-- max_step: 单周期 cmd_pos 最大移动（防跳点/起步弹射/一卡一卡） -->
        <param name="gvf/cmd/max_step" value="0.05" />
        <!-- speed_max: cmd_pos 的最大速度 -->
        <param name="gvf/cmd/speed_max" value="2.0" />
        <!-- vel_lpf_hz: vel 低通截止频率 -->
        <param name="gvf/cmd/vel_lpf_hz" value="4.0" />
        

        <!-- SDF Map -->
        <param name="sdf_map/resolution"   value="0.1" /> 
        <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
        <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
        <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 

        <param name="sdf_map/local_update_range_x"  value="$(arg local_update_range_x)" /> 
        <param name="sdf_map/local_update_range_y"  value="$(arg local_update_range_y)" /> 
        <param name="sdf_map/local_update_range_z"  value="$(arg local_update_range_z)" /> 
        
        <param name="sdf_map/obstacles_inflation"     value="0.099" /> 
        <param name="sdf_map/local_bound_inflate"    value="0.0"/>
        <param name="sdf_map/local_map_margin" value="50"/>
        <param name="sdf_map/ground_height"        value="-0.01"/>

        <!-- depth filter -->
        <param name="sdf_map/use_depth_filter" value="true"/>
        <param name="sdf_map/depth_filter_tolerance" value="0.15"/>
        <param name="sdf_map/depth_filter_maxdist"   value="5.0"/>
        <param name="sdf_map/depth_filter_mindist"   value="0.2"/>
        <param name="sdf_map/depth_filter_margin"    value="2"/>
        <param name="sdf_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="sdf_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="sdf_map/p_hit"  value="0.65"/>
        <param name="sdf_map/p_miss" value="0.35"/>
        <param name="sdf_map/p_min"  value="0.12"/>
        <param name="sdf_map/p_max"  value="0.90"/>
        <param name="sdf_map/p_occ"  value="0.80"/>
        <param name="sdf_map/min_ray_length" value="0.5"/>
        <param name="sdf_map/max_ray_length" value="4.5"/>
        <param name="sdf_map/esdf_slice_height" value="0.3"/>
        <param name="sdf_map/visualization_truncate_height"   value="2.49"/>
        <param name="sdf_map/virtual_ceil_height"   value="2.5"/>
        <param name="sdf_map/show_occ_time"  value="false"/>
        <param name="sdf_map/show_esdf_time" value="false"/>
        <param name="sdf_map/pose_type"     value="2"/>  
        <param name="sdf_map/frame_id"      value="world"/>
        <param name="sdf_map/buffer_refresh_period" value="3.0" />
        <!-- geometric path searching -->
        <param name="astar/lambda_heu" value="10.0" type="double"/>
        <param name="astar/resolution_astar" value="0.1" type="double"/>
        <param name="astar/time_resolution" value="0.8" type="double"/>
        <param name="astar/margin" value="0.6" type="double"/>
        <param name="astar/z_min" value="0.8" type="double"/>
        <param name="astar/z_max" value="1.2" type="double"/>
        <param name="astar/z_ref" value="1.0" type="double"/>
        <param name="astar/w_z" value="20.0" type="double"/>
        <param name="astar/allocate_num" value="1000000" type="int"/>
        <param name="astar/path_sample_interval" value="2" type="int"/>

          <!-- kinodynamic path searching -->
        <param name="search/max_tau" value="0.6" type="double"/>
        <param name="search/init_max_tau" value="0.6" type="double"/>
        <param name="search/max_vel" value="2.0" type="double"/>
        <param name="search/max_acc" value="2.5" type="double"/>
        <param name="search/w_time" value="10.0" type="double"/>
        <param name="search/horizon" value="5.0" type="double"/>
        <param name="search/lambda_heu" value="5.0" type="double"/>
        <param name="search/resolution_astar" value="0.05" type="double"/>
        <param name="search/time_resolution" value="0.33" type="double"/>
        <param name="search/margin" value="0.5" type="double"/>
        <param name="search/allocate_num" value="100000" type="int"/>
        <param name="search/check_num" value="5" type="int"/>
        <param name="search/z_min" value="0.8" type="double"/>
        <param name="search/z_max" value="1.2" type="double"/>

        <!-- kinodynamic path searching -->
        <!-- <param name="search/max_tau" value="0.6" type="double"/>
        <param name="search/init_max_tau" value="0.8" type="double"/>
        <param name="search/max_vel" value="2.5" type="double"/>
        <param name="search/max_acc" value="3.0" type="double"/>
        <param name="search/w_time" value="10.0" type="double"/>
        <param name="search/horizon" value="6.0" type="double"/>
        <param name="search/lambda_heu" value="10.0" type="double"/>
        <param name="search/resolution_astar" value="0.1" type="double"/>
        <param name="search/time_resolution" value="0.8" type="double"/>
        <param name="search/margin" value="0.6" type="double"/>
        <param name="search/allocate_num" value="100000" type="int"/>
        <param name="search/check_num" value="5" type="int"/> -->


        <!-- bspline opt -->
        <param name="planning/traj_order" value="3"/>
        <param name="planning/dimension" value="3" />
        <param name="planning/TrajSampleRate" value="50" />
        <param name="planning/max_vel" value="$(arg v_max)" />
        <param name="planning/max_acc" value="$(arg a_max)" />
        <param name="planning/lambda1" value="8.0" />
        <param name="planning/lambda2" value="5.0" />
        <param name="planning/lambda3" value="10.0" />
        <param name="planning/dist_p" value="0.5" />
        <param name="planning/safe_distance" value="0.4" />
        <param name="planning/opt_maxeval" value="200" />
        <param name="planning/opt_maxtime" value="0.02" />
    </node>

    <node pkg="map_generator" type="local_sensing" name="map_generator" output="screen">
        <param name="sdf_map/resolution" value="0.1" />
        <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
        <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
        <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 
        <param name="sdf_map/local_update_range_x"  value="$(arg local_update_range_x)" /> 
        <param name="sdf_map/local_update_range_y"  value="$(arg local_update_range_y)" /> 
        <param name="sdf_map/local_update_range_z"  value="$(arg local_update_range_z)" /> 
    </node>
</launch>
