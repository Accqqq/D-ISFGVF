<launch>
  <arg name="robot_id"/>
  <arg name="init_x"/>
  <arg name="init_y"/>
  <arg name="init_z"/>

  <!-- One existing SO3 controller instance, connected only to this UAV. -->
  <node pkg="nodelet" type="nodelet"
        name="so3_control_nodelet_$(arg robot_id)"
        args="load so3_control/SO3ControlNodelet /so3_nodelet_manager"
        output="screen">
    <param name="so3_control/init_state_x" value="$(arg init_x)"/>
    <param name="so3_control/init_state_y" value="$(arg init_y)"/>
    <param name="so3_control/init_state_z" value="$(arg init_z)"/>
    <remap from="~odom" to="/uav_$(arg robot_id)/sim/odom"/>
    <remap from="~position_cmd" to="/uav_$(arg robot_id)/position_cmd"/>
    <remap from="~motors" to="/uav_$(arg robot_id)/motors"/>
    <remap from="~corrections" to="/uav_$(arg robot_id)/corrections"/>
    <remap from="~so3_cmd" to="/uav_$(arg robot_id)/so3_cmd"/>
    <remap from="~imu" to="/uav_$(arg robot_id)/sim/imu"/>
    <rosparam file="$(find so3_control)/config/gains_hummingbird.yaml"/>
    <rosparam file="$(find so3_control)/config/corrections_hummingbird.yaml"/>
    <param name="mass" value="0.98"/>
    <param name="use_angle_corrections" value="false"/>
    <param name="use_external_yaw" value="false"/>
    <param name="gains/rot/z" value="1.0"/>
    <param name="gains/ang/z" value="0.1"/>
  </node>

  <!--
    The protected launch uses legacy absolute topic names in the existing
    planner/map stack.  Keep those nodes unchanged and isolate their names at
    this adapter boundary.  /mock_map is the sole shared algorithm input.
  -->
  <group ns="uav_$(arg robot_id)">
    <remap from="/move_base_simple/goal"
           to="/uav_$(arg robot_id)/goal"/>
    <remap from="/gvf_force" to="/uav_$(arg robot_id)/gvf_force"/>
    <remap from="/path_vis" to="/uav_$(arg robot_id)/path_vis"/>
    <remap from="/goal_vis" to="/uav_$(arg robot_id)/goal_vis"/>
    <remap from="/optimization_path"
           to="/uav_$(arg robot_id)/optimization_path"/>

    <remap from="/particle0/path"
           to="/uav_$(arg robot_id)/particle0/path"/>
    <remap from="/particle0/kinopath"
           to="/uav_$(arg robot_id)/particle0/kinopath"/>
    <remap from="/particle0/circle_reference"
           to="/uav_$(arg robot_id)/particle0/circle_reference"/>

    <remap from="/particle0sdf_map/occupancy"
           to="/uav_$(arg robot_id)/particle0sdf_map/occupancy"/>
    <remap from="/particle0sdf_map/occupancy_inflate"
           to="/uav_$(arg robot_id)/particle0sdf_map/occupancy_inflate"/>
    <remap from="/particle0sdf_map/esdf"
           to="/uav_$(arg robot_id)/particle0sdf_map/esdf"/>
    <remap from="/particle0sdf_map/update_range"
           to="/uav_$(arg robot_id)/particle0sdf_map/update_range"/>
    <remap from="/particle0sdf_map/map_boundary"
           to="/uav_$(arg robot_id)/particle0sdf_map/map_boundary"/>
    <remap from="/particle0sdf_map/unknown"
           to="/uav_$(arg robot_id)/particle0sdf_map/unknown"/>
    <remap from="/particle0sdf_map/depth_cloud"
           to="/uav_$(arg robot_id)/particle0sdf_map/depth_cloud"/>

    <remap from="/particle0/gvf/occupancy"
           to="/uav_$(arg robot_id)/particle0/gvf/occupancy"/>
    <remap from="/particle0/gvf/occupancy_inflate"
           to="/uav_$(arg robot_id)/particle0/gvf/occupancy_inflate"/>
    <remap from="/particle0/gvf/esdf"
           to="/uav_$(arg robot_id)/particle0/gvf/esdf"/>
    <remap from="/particle0/gvf/update_range"
           to="/uav_$(arg robot_id)/particle0/gvf/update_range"/>
    <remap from="/particle0/gvf/traj_vis"
           to="/uav_$(arg robot_id)/particle0/gvf/traj_vis"/>
    <remap from="/particle0/gvf/vector_field"
           to="/uav_$(arg robot_id)/particle0/gvf/vector_field"/>

    <!-- Disabled in this fixture, but never leave global manual endpoints. -->
    <remap from="/manual_obstacle"
           to="/uav_$(arg robot_id)/manual_obstacle"/>
    <remap from="/manual_boundary"
           to="/uav_$(arg robot_id)/manual_boundary"/>
    <remap from="/manual_map/add_obstacle_center"
           to="/uav_$(arg robot_id)/manual_map/add_obstacle_center"/>
    <remap from="/manual_map/add_boundary_point"
           to="/uav_$(arg robot_id)/manual_map/add_boundary_point"/>
    <remap from="/manual_map/occupancy"
           to="/uav_$(arg robot_id)/manual_map/occupancy"/>
    <remap from="/clicked_point"
           to="/uav_$(arg robot_id)/clicked_point"/>
    <remap from="/dynamic/obj"
           to="/uav_$(arg robot_id)/dynamic/obj"/>

    <include file="$(find bspline_race)/launch/test_gvf.launch">
      <arg name="drone_id" value="$(arg robot_id)"/>
      <arg name="init_x" value="$(arg init_x)"/>
      <arg name="init_y" value="$(arg init_y)"/>
      <arg name="init_z" value="$(arg init_z)"/>
      <arg name="phase_offset_mode" value="disabled"/>
    </include>

    <!-- Explicit per-agent private parameters, applied after the include. -->
    <group ns="formation_planning">
      <param name="gvf/odom_topic" value="/uav_$(arg robot_id)/sim/odom"/>
      <param name="gvf/cloud_topic" value="/uav_$(arg robot_id)/sim/local_map"/>
      <param name="gvf/cmd_topic" value="/uav_$(arg robot_id)/position_cmd"/>
      <param name="phase_offset/mode" value="disabled"/>
      <param name="gvf/gvf_gain1" value="0.8"/>
      <param name="gvf/gvf_gain2" value="-0.88"/>
      <param name="sdf_map/enable_manual_map" value="false"/>
      <param name="sdf_map/manual_map_auto_load" value="false"/>
      <param name="sdf_map/manual_map_auto_save" value="false"/>
      <param name="sdf_map/frame_id" value="world"/>
    </group>
    <group ns="map_generator">
      <param name="odom_topic" value="/uav_$(arg robot_id)/sim/odom"/>
      <param name="global_map_topic" value="/mock_map"/>
      <param name="local_map_topic" value="/uav_$(arg robot_id)/sim/local_map"/>
      <param name="output_frame" value="world"/>
    </group>
  </group>
</launch>
