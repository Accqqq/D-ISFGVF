<launch>
  <arg name="init_x" default="0.0" />
  <arg name="init_y" default="0.0" />
  <arg name="init_z" default="1.0" />
  <arg name="mode" default="manual" />
  <arg name="amplitude" default="0.10" />
  <arg name="profile_period" default="10.0" />
  <arg name="warmup_cycles" default="100" />
  <arg name="delta_tracking_gain" default="3.0" />
  <arg name="u_w_amplitude" default="0.05" />
  <arg name="u_w_abs_max" default="0.12" />
  <arg name="u_delta_abs_max" default="0.25" />
  <arg name="u_w_rate_max" default="0.60" />
  <arg name="u_delta_rate_max" default="1.20" />
  <arg name="phase_dot_min" default="0.02" />
  <arg name="tangent_speed_min" default="0.02" />
  <arg name="preflight_sample_step_w" default="0.10" />

  <!-- Original single-UAV simulator and SO3 controller, with the same
       private-topic remaps used by the baseline simulator launch. -->
  <node pkg="so3_quadrotor_simulator" type="quadrotor_simulator_so3"
        name="quadrotor_simulator_so3" output="screen">
    <param name="rate/odom" value="100.0" />
    <param name="simulator/init_state_x" value="$(arg init_x)" />
    <param name="simulator/init_state_y" value="$(arg init_y)" />
    <param name="simulator/init_state_z" value="$(arg init_z)" />
    <remap from="~odom" to="/sim/odom" />
    <remap from="~cmd" to="/so3_cmd" />
    <remap from="~imu" to="/sim/imu" />
  </node>

  <node pkg="nodelet" type="nodelet"
        args="standalone so3_control/SO3ControlNodelet"
        name="so3_control" required="true" output="screen">
    <param name="so3_control/init_state_x" value="$(arg init_x)" />
    <param name="so3_control/init_state_y" value="$(arg init_y)" />
    <param name="so3_control/init_state_z" value="$(arg init_z)" />
    <remap from="~odom" to="/sim/odom" />
    <remap from="~position_cmd" to="/position_cmd" />
    <remap from="~motors" to="motors" />
    <remap from="~corrections" to="corrections" />
    <remap from="~so3_cmd" to="/so3_cmd" />
    <remap from="~imu" to="/sim/imu" />
    <rosparam file="$(find so3_control)/config/gains_hummingbird.yaml" />
    <rosparam file="$(find so3_control)/config/corrections_hummingbird.yaml" />
    <param name="mass" value="0.98" />
    <param name="use_angle_corrections " value="false" />
    <param name="use_external_yaw " value="false" />
    <param name="gains/rot/z" value="1.0" />
    <param name="gains/ang/z" value="0.1" />
  </node>

  <include file="$(find bspline_race)/launch/test_gvf.launch">
    <arg name="phase_offset_mode" value="$(arg mode)" />
    <arg name="phase_offset_manual_amplitude" value="$(arg amplitude)" />
    <arg name="phase_offset_manual_profile_period" value="$(arg profile_period)" />
    <arg name="phase_offset_manual_warmup_cycles" value="$(arg warmup_cycles)" />
    <arg name="phase_offset_manual_delta_tracking_gain" value="$(arg delta_tracking_gain)" />
    <arg name="phase_offset_manual_u_w_amplitude" value="$(arg u_w_amplitude)" />
    <arg name="phase_offset_manual_u_w_abs_max" value="$(arg u_w_abs_max)" />
    <arg name="phase_offset_manual_u_delta_abs_max" value="$(arg u_delta_abs_max)" />
    <arg name="phase_offset_manual_u_w_rate_max" value="$(arg u_w_rate_max)" />
    <arg name="phase_offset_manual_u_delta_rate_max" value="$(arg u_delta_rate_max)" />
    <arg name="phase_offset_manual_phase_dot_min" value="$(arg phase_dot_min)" />
    <arg name="phase_offset_manual_tangent_speed_min" value="$(arg tangent_speed_min)" />
    <arg name="phase_offset_manual_preflight_sample_step_w"
         value="$(arg preflight_sample_step_w)" />
  </include>
</launch>
