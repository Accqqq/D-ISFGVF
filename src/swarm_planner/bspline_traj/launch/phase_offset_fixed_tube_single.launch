<launch>
  <arg name="init_x" default="0.0" />
  <arg name="init_y" default="0.0" />
  <arg name="init_z" default="1.0" />
  <!-- Runtime accepts manual amplitudes only from 0.05 m upward. -->
  <arg name="phase_offset_manual_amplitude" default="0.10" />
  <arg name="phase_offset_manual_observe_only" default="true" />

  <node pkg="so3_quadrotor_simulator" type="quadrotor_simulator_so3"
        name="quadrotor_simulator_so3" output="screen">
    <param name="rate/odom" value="100.0" />
    <param name="simulator/init_state_x" value="$(arg init_x)" />
    <param name="simulator/init_state_y" value="$(arg init_y)" />
    <param name="simulator/init_state_z" value="$(arg init_z)" />
    <remap from="~odom" to="/sim/odom" />
    <remap from="~cmd" to="/so3_cmd" />
    <remap from="~imu" to="/sim/imu" />
  </node>

  <node pkg="nodelet" type="nodelet"
        args="standalone so3_control/SO3ControlNodelet"
        name="so3_control" required="true" output="screen">
    <param name="so3_control/init_state_x" value="$(arg init_x)" />
    <param name="so3_control/init_state_y" value="$(arg init_y)" />
    <param name="so3_control/init_state_z" value="$(arg init_z)" />
    <remap from="~odom" to="/sim/odom" />
    <remap from="~position_cmd" to="/position_cmd" />
    <remap from="~motors" to="motors" />
    <remap from="~corrections" to="corrections" />
    <remap from="~so3_cmd" to="/so3_cmd" />
    <remap from="~imu" to="/sim/imu" />
    <rosparam file="$(find so3_control)/config/gains_hummingbird.yaml" />
    <rosparam file="$(find so3_control)/config/corrections_hummingbird.yaml" />
    <param name="mass" value="0.98" />
    <param name="use_angle_corrections " value="false" />
    <param name="use_external_yaw " value="false" />
    <param name="gains/rot/z" value="1.0" />
    <param name="gains/ang/z" value="0.1" />
  </node>

  <include file="$(find bspline_race)/launch/test_gvf.launch">
    <arg name="phase_offset_mode" value="manual" />
    <arg name="phase_offset_manual_amplitude"
         value="$(arg phase_offset_manual_amplitude)" />
    <arg name="phase_offset_manual_observe_only"
         value="$(arg phase_offset_manual_observe_only)" />
    <arg name="phase_offset_manual_profile_period" value="2.0" />
    <arg name="phase_offset_manual_warmup_cycles" value="100" />
    <arg name="phase_offset_manual_delta_tracking_gain" value="3.0" />
    <arg name="phase_offset_manual_u_w_amplitude" value="0.05" />
    <arg name="phase_offset_manual_u_w_abs_max" value="0.12" />
    <arg name="phase_offset_manual_u_delta_abs_max" value="0.25" />
    <arg name="phase_offset_manual_u_w_rate_max" value="0.60" />
    <arg name="phase_offset_manual_u_delta_rate_max" value="1.20" />
    <arg name="phase_offset_manual_phase_dot_min" value="0.02" />
    <arg name="phase_offset_manual_tangent_speed_min" value="0.02" />
    <arg name="phase_offset_manual_preflight_sample_step_w" value="0.10" />
    <arg name="phase_offset_manual_tube_source" value="fixed" />
    <arg name="phase_offset_tube_fixed_delta_max" value="0.04" />
    <arg name="phase_offset_tube_sample_step_w" value="0.10" />
    <arg name="phase_offset_tube_lookahead_w" value="2.0" />
    <arg name="phase_offset_tube_back_w" value="0.20" />
    <arg name="phase_offset_tube_min_certified_forward_w" value="0.40" />
    <arg name="phase_offset_tube_ray_step" value="0.05" />
    <arg name="phase_offset_tube_max_offset" value="0.20" />
    <arg name="phase_offset_tube_boundary_slope_max" value="0.80" />
    <arg name="phase_offset_tube_invariant_gain" value="1.0" />
    <arg name="phase_offset_tube_interior_margin" value="0.0" />
    <arg name="phase_offset_tube_stable_rebuild_cycles" value="1" />
    <arg name="phase_offset_tube_esdf_unobserved_threshold" value="1000.0" />
    <arg name="phase_offset_tube_uav_radius" value="0.25" />
    <arg name="phase_offset_tube_localization_margin" value="0.05" />
    <arg name="phase_offset_tube_tracking_error_bound" value="0.15" />
    <arg name="phase_offset_tube_map_margin" value="0.10" />
    <arg name="phase_offset_tube_extra_margin" value="0.05" />
    <arg name="phase_offset_tube_discretization_margin" value="0.10" />
  </include>
</launch>
