<launch>
  <!--
    World for the pillar -> reformation gap -> narrow corridor scenario
    (resource/pillar_gap_corridor.pcd, regenerated by
    dynamic_map_generator/scripts/make_pillar_gap_corridor.py).

    Layout along the southbound flight axis (start at the north end):
      y [ 14.0, -0.6]  pillar field   (authentic crop of pillar.pcd)
      y [ -0.6, -5.6]  reformation gap (5.4 m of free space)
      y [ -5.6,-10.6]  entrance funnel (free half-width 6.0 m -> 1.5 m)
      y [-10.6,-19.6]  narrow corridor (3.0 m clear opening, 9 m long)
      y [-19.6,-30.0]  exit bay        (goal disk lands here)

    Funnel and corridor walls run out to the map window edge (|x| = 10 m), so
    the 3 m opening is the only passage and the cluster is forced through it;
    keep map_size_x at its 20 m default.

    The swarm itself stays phase_offset_swarm.launch; the scenario needs its
    map window and goal translation to match the map:

      roslaunch phase_offset_sim_bringup phase_offset_world_pillar_gap.launch
      roslaunch phase_offset_sim_bringup phase_offset_swarm.launch \
        agent_count:=15 publish_goals:=true \
        formation_goal_translation_y:=-47.0 map_size_y:=80
  -->
  <arg name="map_file"
       default="$(find map_generator)/resource/pillar_gap_corridor.pcd"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="enable_follow_rviz" default="true"/>

  <include file="$(find phase_offset_sim_bringup)/launch/phase_offset_world.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="enable_rviz" value="$(arg enable_rviz)"/>
    <arg name="enable_follow_rviz" value="$(arg enable_follow_rviz)"/>
  </include>
</launch>
