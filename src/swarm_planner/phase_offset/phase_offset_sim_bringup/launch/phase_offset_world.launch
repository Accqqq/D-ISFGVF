<launch>
  <!--
    Shared read-only WORLD infrastructure.  This entry point deliberately
    does not start a simulator, controller, planner, goal publisher, or any
    swarm/control implementation.  SWARM owns those processes.
  -->
  <!-- Optional read-only preload.  The world itself carries no swarm size: the
       agent count lives in the swarm launch (phase_offset_swarm.launch
       agent_count), and its orchestrator publishes the agent list to
       /sim_b_world/scenario/agents.  The visualizer below waits for that, so
       the two launches stay independent.  Pass a scenario_file here only to
       display agents without running the swarm. -->
  <arg name="scenario_file" default=""/>
  <arg name="map_file"
       default="$(find map_generator)/resource/pillar.pcd"/>
  <arg name="frame_id" default="world"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="rviz_config"
       default="$(find phase_offset_sim_bringup)/rviz/phase_offset_sim_b.rviz"/>
  <!-- Second window, mirroring the single-UAV chain's fpv.rviz: same content,
       camera following one agent (that agent's odom_visualization broadcasts
       world->base; pick it with the swarm launch's rviz_follow_agent). -->
  <arg name="enable_follow_rviz" default="true"/>
  <arg name="follow_rviz_config"
       default="$(find phase_offset_sim_bringup)/rviz/phase_offset_follow.rviz"/>
  <!-- Flown-path trail published on /phase_offset_swarm/vis/trajectories.
       It is persistent (a finished flight stays visible), decimated to one
       point per trajectory_min_step metres so a long run still draws cheaply,
       and it restarts only on an odometry jump larger than
       trajectory_reset_step (a new run / teleport) or when the agent list
       changes.  trajectory_buffer is the hard point cap. -->
  <arg name="trajectory_buffer" default="20000"/>
  <arg name="trajectory_min_step" default="0.05"/>
  <arg name="trajectory_reset_step" default="5.0"/>

  <!-- Sole scenario source for the generic-N read-only visualizer. -->
  <rosparam command="load" file="$(arg scenario_file)" ns="/sim_b_world"
            if="$(eval arg('scenario_file') != '')"/>

  <node pkg="map_generator" type="map_pub" name="map_pub" output="screen"
        args="$(arg map_file)"/>

  <node pkg="phase_offset_sim_bringup" type="swarm_visualizer"
        name="phase_offset_swarm_visualizer" output="screen">
    <param name="scenario_param" value="/sim_b_world/scenario/agents"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="trajectory_buffer" value="$(arg trajectory_buffer)"/>
    <param name="trajectory_min_step" value="$(arg trajectory_min_step)"/>
    <param name="trajectory_reset_step" value="$(arg trajectory_reset_step)"/>
  </node>

  <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="rviz"
        output="screen" required="true" args="-d $(arg rviz_config)"/>

  <node if="$(arg enable_follow_rviz)" pkg="rviz" type="rviz"
        name="rviz_follow" output="screen"
        args="-d $(arg follow_rviz_config)"/>
</launch>
