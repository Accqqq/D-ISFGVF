    - Class: rviz/Marker
      Enabled: false
      Name: UAV2 Tube active path
      Marker Topic: /uav_2/formation_planning/phase_offset_manual/active_path
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Name: UAV2 Tube frame
      Marker Topic: /uav_2/formation_planning/phase_offset_manual/frame
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
