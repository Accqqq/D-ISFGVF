      Marker Topic: /uav_1/formation_planning/phase_offset_manual/tube_candidate
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Name: UAV1 Tube certified
      Marker Topic: /uav_1/formation_planning/phase_offset_manual/tube
