    - Class: rviz/PointCloud2
      Enabled: false
      Name: UAV2 ESDF
      Topic: /uav_2/particle0sdf_map/esdf
      Queue Size: 10
      Style: Points
      Size (Pixels): 2
      Use Fixed Frame: true
      Value: false
    - Class: rviz/Path
      Enabled: false
      Name: UAV2 planner path
      Topic: /uav_2/particle0/path
      Queue Size: 10
      Value: false
    - Class: rviz/Path
      Enabled: false
      Name: UAV2 kino path
      Topic: /uav_2/particle0/kinopath
      Queue Size: 10
      Value: false
    - Class: rviz/Marker
      Enabled: false
      Name: UAV2 path visualization
      Marker Topic: /uav_2/path_vis
      Queue Size: 100
